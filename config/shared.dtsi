#define HRM_TAPPING_TERM      280
#define HRM_TAPPING_TERM_FAST 200
#define HRM_QUICK_TAP         175
#define HRM_PRIOR_IDLE        150

// layers
#define QWERTY    0 // a.k.a default
#define DVORAK    1
#define COLEMAK   2

// #define NUMBERS   4
// #define FUNK      5
// #define LAYERS    6
// #define GAM_NUM   7
// #define GAM_ARR   8
// #define MOUSE     9
// #define SYMB     10

#define GAM_DEF   3
#define GAM_NUM   4
// #define GAM_ARR   5

#define NUMBERS   5
#define SYMB     9

#define FUNK      6
#define MOUSE     8

#define LAYERS    7
#define WINDOWS  10

#define T_L MOUSE RET
#define T_R FUNK  SPACE

&mt {
  tapping-term-ms = <200>;
  quick-tap-ms = <0>;
  flavor = "tap-preferred";
};

&lt {
  tapping-term-ms = <300>;
  quick-tap-ms = <0>;
  flavor = "tap-preferred";
};

&sk {
  release-after-ms = <500>;
  quick-release;
};

/ {
  behaviors {
    alt_gui: alt_gui {
      compatible = "zmk,behavior-tap-dance";
      #binding-cells = <0>;
      bindings = <&kp LALT>, <&kp LGUI>;

      tapping-term-ms = <150>;
      quick-tap-ms = <80>;
    };

    ltg: lt_gam {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      bindings = <&mo>, <&kp>;

      flavor = "hold-preferred";
      tapping-term-ms = <150>;
    };

  };
};

// ---
// for 40 41 combo hold can be used 8 9 20 21
// for 36 37 combo hold can be used 12 24 2 3 14 15
// ---
// default layer to switch essential layer or switch bt profile
//
// ---
